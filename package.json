{
  "name": "wake-pc",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "package": "pnpm build && rm -rf .pkg wake-pc.zip && mkdir -p .pkg/wake-pc && cp plugin.json main.py package.json README.md LICENSE .pkg/wake-pc/ && cp -r dist .pkg/wake-pc/ && cd .pkg && zip -r -q ../wake-pc.zip wake-pc && cd .. && rm -rf .pkg"
  },
  "dependencies": {
    "@decky/api": "latest",
    "@decky/ui": "latest",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/react": "^18.2.0",
    "rollup": "^4.0.0",
    "tslib": "^2.9.1",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}